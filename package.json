{
  "name": "hashpilot",
  "version": "0.1.0",
  "description": "AI-powered MCP server for Hedera blockchain development - integrates with Claude Desktop, Cursor, Windsurf, and VS Code",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "hashpilot": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "prepublishOnly": "npm run build",
    "index-docs": "tsx scripts/index-docs.ts",
    "index-sdk": "tsx scripts/index-sdk.ts",
    "index-hips": "tsx scripts/index-hips.ts",
    "index-network": "tsx scripts/index-network-config.ts",
    "index-tutorials": "tsx scripts/index-tutorials.ts",
    "index-all": "tsx scripts/index-all.ts",
    "test-rag": "tsx scripts/test-rag-coverage.ts"
  },
  "keywords": [
    "hedera",
    "hashgraph",
    "mcp",
    "model-context-protocol",
    "blockchain",
    "ai-assistant",
    "developer-tools",
    "claude",
    "cursor",
    "windsurf",
    "hbar",
    "smart-contracts",
    "web3"
  ],
  "author": "Mert Köklü",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@graphql-tools/utils": "^10.10.1",
    "@hashgraph/sdk": "^2.49.2",
    "@hashgraph/stablecoin-npm-sdk": "^2.1.5",
    "@mendable/firecrawl-js": "^4.5.0",
    "@modelcontextprotocol/sdk": "^1.21.0",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-ignition": "^0.15.6",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.6",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.11",
    "axios": "^1.7.7",
    "chromadb": "^1.9.2",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.0",
    "graphql": "^16.12.0",
    "graphql-request": "^6.1.0",
    "hardhat": "^2.22.16",
    "openai": "^4.63.0",
    "tiktoken": "^1.0.22",
    "winston": "^3.15.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.13",
    "@types/node": "^20.16.11",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/justmert/hashpilot.git"
  },
  "bugs": {
    "url": "https://github.com/justmert/hashpilot/issues"
  },
  "homepage": "https://github.com/justmert/hashpilot#readme"
}
