{
  "name": "hashpilot",
  "version": "0.2.1",
  "description": "MCP server for building on Hedera: tokens, contracts, Mirror Node, GraphQL and docs, for Claude, Cursor, VS Code, Windsurf and Gemini CLI",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "hashpilot": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "prepublishOnly": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && npm run build",
    "index-docs": "tsx scripts/index-docs.ts",
    "index-docs-repo": "tsx scripts/index-docs-repo.ts",
    "index-sdk": "tsx scripts/index-sdk.ts",
    "index-hips": "tsx scripts/index-hips.ts",
    "index-network": "tsx scripts/index-network-config.ts",
    "index-tutorials": "tsx scripts/index-tutorials.ts",
    "index-specs": "tsx scripts/index-specs.ts",
    "index-all": "tsx scripts/index-all.ts",
    "test-rag": "tsx scripts/test-rag-coverage.ts",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.integration.config.js",
    "smoke": "tsx scripts/smoke-test.ts",
    "test:rag-e2e": "tsx scripts/test-rag-e2e.ts",
    "mock-openai": "tsx scripts/mock-openai.ts",
    "check:sources": "tsx scripts/check-index-sources.ts",
    "check:sourcify": "tsx scripts/check-sourcify.ts",
    "test:mcp": "tsx scripts/test-mcp-protocol.ts"
  },
  "keywords": [
    "hedera",
    "hashgraph",
    "mcp",
    "model-context-protocol",
    "blockchain",
    "ai-assistant",
    "developer-tools",
    "claude",
    "cursor",
    "windsurf",
    "hbar",
    "smart-contracts",
    "web3",
    "hiero",
    "mcp-server",
    "mirror-node",
    "graphql",
    "hardhat",
    "foundry",
    "gemini-cli"
  ],
  "author": "Mert Köklü",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@hashgraph/sdk": "^2.49.2",
    "@hashgraph/stablecoin-npm-sdk": "^2.1.5",
    "@mendable/firecrawl-js": "^4.5.0",
    "@modelcontextprotocol/sdk": "^1.21.0",
    "axios": "^1.7.7",
    "chromadb": "^1.9.2",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.0",
    "graphql": "^16.14.2",
    "openai": "^4.63.0",
    "tiktoken": "^1.0.22",
    "winston": "^3.15.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.13",
    "@types/node": "^20.16.11",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/justmert/hashpilot.git"
  },
  "bugs": {
    "url": "https://github.com/justmert/hashpilot/issues"
  },
  "homepage": "https://github.com/justmert/hashpilot#readme"
}
