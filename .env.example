# =============================================================================
# HashPilot MCP Server - Indexing Secrets
# =============================================================================
# This file is ONLY for admin operations (indexing, maintenance).
# Regular users don't need this file - they configure via .mcp.json
# =============================================================================

# OpenAI API Key (for indexing - users provide their own in MCP config)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx

# Firecrawl Configuration (for documentation indexing)
FIRECRAWL_URL=http://localhost:3002

# GitHub Token (for SDK indexing - increases rate limit)
GITHUB_TOKEN=github_pat_xxxxxxxxxxxx

# Log level
LOG_LEVEL=info
