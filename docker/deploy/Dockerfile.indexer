# HashPilot RAG Indexer Service
# Multi-stage build for ARM64 (AWS EC2 Graviton)

# ============================================
# Stage 1: Builder
# ============================================
FROM node:20-slim AS builder

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y \
    git \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Copy package files
COPY package*.json ./

# Install all dependencies (including devDependencies for build)
RUN npm install

# Copy source code
COPY tsconfig.json ./
COPY src/ ./src/

# Build TypeScript
RUN npm run build

# ============================================
# Stage 2: Production
# ============================================
FROM node:20-slim AS production

WORKDIR /app

# Install runtime dependencies + build tools for native modules
RUN apt-get update && apt-get install -y \
    git \
    curl \
    ca-certificates \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user for security
RUN groupadd -r hashpilot && useradd -r -g hashpilot hashpilot

# Copy package files
COPY package*.json ./
COPY tsconfig.json ./

# Install all dependencies (tsx is needed for running scripts)
RUN npm install

# Copy built application from builder
COPY --from=builder /app/dist ./dist

# Copy source files (needed for tsx imports)
COPY src/ ./src/

# Copy indexing scripts
COPY scripts/ ./scripts/

# Create cache directory
RUN mkdir -p /app/cache && chown -R hashpilot:hashpilot /app

# Switch to non-root user
USER hashpilot

# Environment variables
ENV NODE_ENV=production \
    LOG_LEVEL=info

# Health check
HEALTHCHECK --interval=60s --timeout=10s --start-period=30s --retries=3 \
    CMD node -e "process.exit(0)"

# Default command: keep container running for manual indexing
CMD ["node", "-e", "console.log('HashPilot RAG Indexer ready. Use deploy.sh to run indexing commands.'); setInterval(() => {}, 60000)"]
